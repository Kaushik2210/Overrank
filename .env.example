# Supabase project (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by `npm run seed` to create the faculty admin.
# If ADMIN_PASSWORD is empty a random one is generated and printed once.
ADMIN_EMAIL=admin@overrank.local
ADMIN_PASSWORD=

# Leave the Supabase values empty to run the in-memory preview instead.
# The preview starts with every team at 0 points. Set to 1 to load invented demo activity.
OVERRANK_DEMO=0

# Preview-mode cookie signing key. Optional; a random one is used per process otherwise.
SESSION_SECRET=

# Deployed preview only (no Supabase): password for faculty sign-in and a stable cookie-signing key.
PREVIEW_ADMIN_PASSWORD=
